# 12th House AI — Production Environment Variables
# Copy to .env and fill in your values

# VPS
VPS_IP=76.13.98.156

# n8n
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Compliance Agent
COMPLIANCE_AGENT_MODEL=gemini-2.5-flash
COMPLIANCE_DB_PATH=/app/data/compliance.duckdb

# Google AI (choose one backend)
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1

# OpenAI Admin API (for license sync workflow)
OPENAI_ADMIN_API_KEY=YOUR_OPENAI_ADMIN_KEY

# Microsoft Graph (for O365 license sync)
MICROSOFT_GRAPH_CLIENT_ID=YOUR_CLIENT_ID
MICROSOFT_GRAPH_CLIENT_SECRET=YOUR_CLIENT_SECRET
MICROSOFT_GRAPH_TENANT_ID=YOUR_TENANT_ID

# Email (SMTP for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_TO=alerts@12thhouseai.com

# Slack (optional)
SLACK_WEBHOOK_URL=
