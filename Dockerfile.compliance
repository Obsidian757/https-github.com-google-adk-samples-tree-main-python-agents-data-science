FROM python:3.12-slim

WORKDIR /app

# Install uv for fast dependency management
RUN pip install uv

# Copy project files
COPY pyproject.toml uv.lock ./
COPY compliance_agent/ ./compliance_agent/
COPY data_science/ ./data_science/
COPY compliance.duckdb ./data/compliance.duckdb

# Install dependencies
RUN uv sync --no-dev --python python3.12

# Expose the API port
EXPOSE 8080

# Run the compliance agent API
CMD ["uv", "run", "uvicorn", "compliance_agent.agent:app", "--host", "0.0.0.0", "--port", "8080"]
